#!/usr/bin/env bash
# agy-gpt: Launch Antigravity CLI (agy) backed by Magpie + OpenCode Model Pool.
# Default model: magpie/codex/gpt-6.1-sol (Standard tier, medium reasoning effort).
# Supports:
#   agy-gpt                                           # interactive TUI on gpt-6.1-sol
#   agy-gpt --fast                                    # interactive TUI on gpt-6.1-sol-fast
#   agy-gpt --ultrafast                               # interactive TUI on gpt-6.1-sol-ultrafast
#   agy-gpt --astra                                   # interactive TUI on gpt-6-astra
#   agy-gpt --model 'magpie/word-claude/word/claude-opus-5-5'
#   agy-gpt --continue                                # resume most recent conversation
set -euo pipefail

CLOUD_KEY_FILE="$HOME/.config/magpie/cloud-caller-key"
if [[ -z "${GEMINI_API_KEY:-}" || "${GEMINI_API_KEY:-}" == "magpie-agy" ]]; then
  if [[ -f "$CLOUD_KEY_FILE" ]]; then
    GEMINI_API_KEY="$(tr -d '[:space:]' < "$CLOUD_KEY_FILE")"
  else
    GEMINI_API_KEY="magpie-agy"
  fi
fi
export GEMINI_API_KEY
if [[ -z "${GOOGLE_GEMINI_BASE_URL:-}" || "${GOOGLE_GEMINI_BASE_URL:-}" == "http://127.0.0.1:3425" ]]; then
  GOOGLE_GEMINI_BASE_URL="https://newapi.resumegenkk.xyz"
fi
export GOOGLE_GEMINI_BASE_URL
export HTTP_PROXY="${HTTP_PROXY:-http://127.0.0.1:17845}"
export HTTPS_PROXY="${HTTPS_PROXY:-http://127.0.0.1:17845}"

python3 -c '
import json
from pathlib import Path
p = Path.home() / ".gemini/antigravity-cli/settings.json"
if p.exists():
    d = json.loads(p.read_text())
    if d.get("modelProvider") != "gemini":
        d["modelProvider"] = "gemini"
        p.write_text(json.dumps(d, indent=2) + "\n")
' 2>/dev/null || true

MODEL="magpie/codex/gpt-6.1-sol"
EFFORT_SUFFIX=""
HAS_MODEL=0
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --high)
      EFFORT_SUFFIX="-high"
      shift
      ;;
    --max)
      EFFORT_SUFFIX="-max"
      shift
      ;;
    --fast)
      MODEL="magpie/codex/gpt-6.1-sol-fast"
      shift
      ;;
    --ultrafast)
      MODEL="magpie/codex/gpt-6.1-sol-ultrafast"
      shift
      ;;
    --astra)
      MODEL="magpie/codex/gpt-6-astra"
      shift
      ;;
    --astra-fast)
      MODEL="magpie/codex/gpt-6-astra-fast"
      shift
      ;;
    --astra-ultrafast)
      MODEL="magpie/codex/gpt-6-astra-ultrafast"
      shift
      ;;
    -m|--model|--model=*)
      HAS_MODEL=1
      ARGS+=("$1")
      shift
      if [[ "${ARGS[${#ARGS[@]}-1]}" == "-m" || "${ARGS[${#ARGS[@]}-1]}" == "--model" ]] && [[ $# -gt 0 ]]; then
        ARGS+=("$1")
        shift
      fi
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "$HAS_MODEL" -eq 0 ]]; then
  exec agy --model "${MODEL}${EFFORT_SUFFIX}" "${ARGS[@]}"
else
  exec agy "${ARGS[@]}"
fi
